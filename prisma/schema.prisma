datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  username     String?  @unique
  phone        String?  @unique
  email        String?  @unique
  name         String
  firstName    String?
  lastName     String?
  birthDate    String?
  passwordHash String
  role         String   @default("CUSTOMER") // ADMIN, CUSTOMER
  avatar       String?
  address      String?
  createdAt    DateTime @default(now())
  orders       Order[]
}

model EmailVerificationCode {
  id         String   @id @default(cuid())
  email      String   @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  purpose    String   @default("REGISTER") // REGISTER, PASSWORD_RESET
  createdAt  DateTime @default(now())
}

model Category {
  id        String    @id
  name      String
  icon      String?
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id            String   @id
  name          String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  price         Float
  oldPrice      Float?
  weight        String?
  calories      String?
  image         String
  description   String?
  isPopular     Boolean  @default(false)
  isChefSpecial Boolean  @default(false)
  inStock       Boolean  @default(true)
  optionsJson   String?  @default("[]") // JSON string of options [{name, price}]
  createdAt     DateTime @default(now())
}

model Order {
  id              String               @id
  orderNumber     String?              @unique
  userId          String?
  user            User?                @relation(fields: [userId], references: [id])
  customerName    String
  phone           String
  address         String
  deliveryType    String               @default("delivery") // delivery, pickup
  paymentMethod   String               @default("cash")     // payme, click, card, cash
  paymentStatus   String               @default("pending")  // pending, paid, cash_on_delivery, failed
  status          String               @default("new")      // new, accepted, cooking, ready, completed, rejected, cancelled
  itemsTotal      Float
  discountAmount  Float                @default(0)
  promoCode       String?
  deliveryFee     Float                @default(0)
  total           Float
  comment         String?
  rejectionReason String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String   // new, accepted, cooking, ready, completed, rejected, cancelled
  comment   String?
  createdAt DateTime @default(now())
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  name        String
  price       Float
  quantity    Int
  optionsJson String? @default("[]")
}

model Review {
  id        String   @id @default(cuid())
  author    String
  avatar    String?
  rating    Int
  text      String
  date      String?
  status    String   @default("approved") // approved, pending, rejected
  createdAt DateTime @default(now())
}

model CafeSettings {
  id                    String  @id @default("default")
  cafeName              String  @default("AMERICAN")
  phone                 String  @default("+998 90 822 01 01")
  address               String  @default("ул. Амира Темура, 45")
  deliveryFee           Float   @default(15000)
  freeDeliveryThreshold Float   @default(150000)
  minOrderAmount        Float   @default(30000)
  isOpen                Boolean @default(true)
  workHours             String  @default("09:00 – 22:00")
  bannerText            String  @default("Бесплатная доставка от 150 000 сум! 🔥")
}

model PromoCode {
  id              String  @id @default(cuid())
  code            String  @unique
  discountPercent Float   @default(0)
  discountAmount  Float   @default(0)
  minOrder        Float   @default(0)
  isActive        Boolean @default(true)
}
